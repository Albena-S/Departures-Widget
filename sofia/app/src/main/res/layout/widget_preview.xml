    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg_light" android:orientation="vertical"
    android:paddingStart="14dp" android:paddingTop="12dp" android:paddingEnd="14dp" android:paddingBottom="12dp"
